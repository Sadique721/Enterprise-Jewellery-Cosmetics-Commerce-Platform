<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.antigravity.sanab</groupId>
        <artifactId>sanab-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sanab-analytics</artifactId>
    <name>SANAB :: Analytics</name>
    <description>
        Business Intelligence &amp; Analytics domain — executive metrics, revenue reporting,
        order performance, user acquisition trends, and inventory forecasting.
    </description>

    <dependencies>
        <!-- Shared Kernel -->
        <dependency>
            <groupId>com.antigravity.sanab</groupId>
            <artifactId>sanab-shared</artifactId>
        </dependency>

        <!-- Orders Module -->
        <dependency>
            <groupId>com.antigravity.sanab</groupId>
            <artifactId>sanab-orders</artifactId>
        </dependency>

        <!-- Catalog Module -->
        <dependency>
            <groupId>com.antigravity.sanab</groupId>
            <artifactId>sanab-catalog</artifactId>
        </dependency>

        <!-- Identity Module -->
        <dependency>
            <groupId>com.antigravity.sanab</groupId>
            <artifactId>sanab-identity</artifactId>
        </dependency>

        <!-- Payments Module -->
        <dependency>
            <groupId>com.antigravity.sanab</groupId>
            <artifactId>sanab-payments</artifactId>
        </dependency>

        <!-- Reviews Module -->
        <dependency>
            <groupId>com.antigravity.sanab</groupId>
            <artifactId>sanab-reviews</artifactId>
        </dependency>

        <!-- Notifications Module -->
        <dependency>
            <groupId>com.antigravity.sanab</groupId>
            <artifactId>sanab-notifications</artifactId>
        </dependency>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Modulith -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- OpenAPI docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
        <!-- Apache POI for Excel/Word Exports -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>
    </dependencies>
</project>
